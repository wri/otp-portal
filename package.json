    "sharp": "^0.35"
  },
  "scripts": {
    "dev": "NODE_ENV=development PORT=4000 next dev",
    "dev:debug": "NODE_ENV=development NODE_OPTIONS='--inspect' next dev",
    "build": "next build --webpack",
    "build:coverage": "COVERAGE=true next build --webpack",
    "stats": "script/route-bundle-stats",
    "build:stats": "BUILD_DIR=.next-stats-turbopack next build && BUILD_DIR=.next-stats-webpack next build --webpack && script/route-bundle-stats .next-stats-turbopack .next-stats-webpack",
    "postbuild": "script/compress-static",
    "start": "NODE_ENV=${NODE_ENV:-production} PORT=${PORT:-4000} next start",
    "prod": "yarn build && yarn start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run --config vitest.smoke.config.mjs",
    "test:coverage": "vitest run --coverage",
    "coverage:report": "script/coverage-report",
    "transifex:push": "env $(grep ^TX_TOKEN -m 1 .env | xargs) tx push -s",
    "transifex:pull": "env $(grep ^TX_TOKEN -m 1 .env | xargs) tx pull -a -f && node transifex/format-locales.js"
  },
  "prettier": {
    "singleQuote": true
  }
}
